# syntax=docker/dockerfile:1.7
# Build from this game checkout with pinned Fabric, Metta, and policy contexts:
# docker buildx build --platform linux/amd64 --load \
#   --build-context fabric=/path/to/fabric-at-bea92fff \
#   --build-context metta=/path/to/metta \
#   --build-context bundle=/path/to/train_dir/derks_native/policy \
#   -f Dockerfile.trained -t derks-frozen:local .

FROM python:3.12-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:0.9.18 /uv /usr/local/bin/uv

COPY --from=fabric / /src/fabric/
COPY --from=metta /packages/metta-training /src/metta-training
COPY pyproject.toml README.md /src/game/
COPY players/ /src/game/players/
COPY server/ /src/game/server/

RUN uv venv /opt/venv && uv pip install --no-config \
    --python /opt/venv/bin/python \
    /src/fabric /src/metta-training /src/game

FROM python:3.12-slim
COPY --from=builder /opt/venv /opt/venv
COPY --from=bundle / /opt/policy/
ENV PATH="/opt/venv/bin:$PATH" \
    DERKS_POLICY_BUNDLE=/opt/policy \
    PYTHONUNBUFFERED=1
CMD ["python", "-m", "players.trained_player"]
